# --- Hevy ---
HEVY_API_KEY=your_hevy_pro_api_key

# --- Garmin token source ---
# HOST-side path, read by docker-compose (not the app itself) to bind-mount
# garmin-scale-sync's token directory read-only into the container at the
# fixed path /app/garmin_tokens_source. Locally this defaults to
# ./.garminconnect (see docker-compose.yml); on the Oracle VM point it at
# garmin-scale-sync's real data dir, e.g. /opt/garmin-scale-sync/data/.garminconnect
# Do NOT set GARMIN_TOKEN_SOURCE_DIR here — that's the container-internal
# path the app reads (src/config.py), and it must stay /app/garmin_tokens_source.
GARMIN_TOKEN_HOST_DIR=./.garminconnect

# --- Garmin self-healing re-auth ---
# Used ONLY when the shared token store is rejected by the API and a full
# credential re-login is needed — mirrors garmin-scale-sync's own pattern.
# If Garmin requests an MFA code during that re-login, submit it via the
# dashboard (a box appears automatically when one is pending).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Hevy webhook (fast primary trigger for new workouts) ---
# Only fires on workout.created (not edits/deletes — see polling below).
# Requires a publicly reachable URL (e.g. the Oracle VM's domain/IP) so
# Hevy's servers can reach this container. Leave PUBLIC_BASE_URL blank to
# skip webhook registration entirely and rely on polling instead.
HEVY_WEBHOOK_AUTH_TOKEN=generate_a_long_random_string
PUBLIC_BASE_URL=
WEBHOOK_RETRY_DELAYS_MINUTES=5,10,15

# --- Matching & sync timing ---
MATCH_TOLERANCE_MINUTES=15
SYNC_INTERVAL_MINUTES=15
# Polling is a reconciliation safety net (catches edits/deletes and any
# missed webhook), not the primary trigger. Off by default — toggle live
# from the dashboard without restarting the container.
POLLING_ENABLED_DEFAULT=false

# --- Set timeline synthesis (Phase E) ---
WORKING_SET_SECONDS=40
WARMUP_SET_SECONDS=25
REST_BETWEEN_SETS_SECONDS=75
REST_BETWEEN_EXERCISES_SECONDS=120

# --- Dashboard ---
PORT=8000
API_BASIC_AUTH_USERNAME=admin
API_BASIC_AUTH_PASSWORD=change_me_to_something_secure
PERSIST_LOGS=false
DRY_RUN=false

# --- Alerting (optional) ---
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATA_DIR=/app/data
