# --- Hevy ---
HEVY_API_KEY=your_hevy_pro_api_key

# --- Garmin token source (SHARED — must be read/WRITE) ---
# HOST-side path, read by docker-compose (not the app itself) to bind-mount
# garmin-scale-sync's token directory into the container at the fixed path
# /app/garmin_tokens_source. Locally this defaults to ./.garminconnect (see
# docker-compose.yml); on the Oracle VM point it at garmin-scale-sync's real
# data dir, e.g. /opt/garmin-scale-sync/data/.garminconnect
#
# This mount must stay writable (no :ro). Garmin issues a NEW refresh token on
# every refresh and invalidates the old one, so the account has exactly one
# valid refresh token at any moment. When this service refreshes it has to
# publish the new token back here, or garmin-scale-sync carries on using the
# token that was just invalidated — and vice versa. Writes are atomic and
# guarded by a lock file in the same directory, so concurrent access is safe.
#
# Do NOT set GARMIN_TOKEN_SOURCE_DIR here — that's the container-internal
# path the app reads (src/config.py), and it must stay /app/garmin_tokens_source.
#
# Only used when TOKEN_STORE=file (see below). With TOKEN_STORE=postgres the
# token lives in the database and this mount is unused.
GARMIN_TOKEN_HOST_DIR=./.garminconnect

# --- Shared Garmin token store ---
# Garmin mints a NEW refresh token on every refresh and invalidates the old one,
# so the account has exactly one valid refresh token at any moment. Every service
# on this account must point at the SAME store, or whichever refreshes second is
# locked out until it does its own credential login — which then locks out the
# first. That ping-pong is what this setting exists to prevent.
#
#   file      GARMIN_TOKEN_SOURCE_DIR/garmin_tokens.json. Atomic writes guarded
#             by a lock file. Same host only — both containers must share the
#             bind mount.
#   sqlite    $DATA_DIR/garmin_tokens.db. Real write locking. Same host only;
#             SQLite locking is unreliable over NFS/SMB.
#   postgres  Requires TOKEN_DB_URL. The only option when services run on
#             different hosts — coordination happens in the database, so no
#             shared filesystem is needed.
#
# !! This MUST match garmin-scale-sync's TOKEN_STORE. Pointing the two services
# !! at different stores silently splits them onto separate sessions, and each
# !! will keep invalidating the other's token.
TOKEN_STORE=file

# Only used when TOKEN_STORE=postgres. Must be the SAME database and credentials
# garmin-scale-sync uses — the whole point is one shared row. For Neon, either
# endpoint works: the store takes a transaction-scoped advisory lock
# (pg_advisory_xact_lock), which is safe behind the pooled PgBouncer endpoint.
# TOKEN_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Garmin self-healing re-auth ---
# Used ONLY when the shared token store is rejected by the API and a full
# credential re-login is needed — mirrors garmin-scale-sync's own pattern.
# Credential logins hit Garmin's SSO endpoint, which is rate-limited per IP,
# so this must stay a genuinely rare path.
# If Garmin requests an MFA code during that re-login, submit it via the
# dashboard (a box appears automatically when one is pending).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Hevy webhook (fast primary trigger for new workouts) ---
# Only fires on workout.created (not edits/deletes — see polling below).
# Requires a publicly reachable URL (e.g. the Oracle VM's domain/IP) so
# Hevy's servers can reach this container. Leave PUBLIC_BASE_URL blank to
# skip webhook registration entirely and rely on polling instead.
HEVY_WEBHOOK_AUTH_TOKEN=generate_a_long_random_string
PUBLIC_BASE_URL=
WEBHOOK_RETRY_DELAYS_MINUTES=5,10,15

# --- Matching & sync timing ---
MATCH_TOLERANCE_MINUTES=15
SYNC_INTERVAL_MINUTES=15
# Polling is a reconciliation safety net (catches edits/deletes and any
# missed webhook), not the primary trigger. Off by default — toggle live
# from the dashboard without restarting the container.
POLLING_ENABLED_DEFAULT=false

# --- Set timeline synthesis (Phase E) ---
WORKING_SET_SECONDS=40
WARMUP_SET_SECONDS=25
REST_BETWEEN_SETS_SECONDS=75
REST_BETWEEN_EXERCISES_SECONDS=120

# --- Dashboard ---
PORT=8000
API_BASIC_AUTH_USERNAME=admin
API_BASIC_AUTH_PASSWORD=change_me_to_something_secure
PERSIST_LOGS=false
DRY_RUN=false

# --- Alerting (optional) ---
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATA_DIR=/app/data
